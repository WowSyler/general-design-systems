{
  "name": "desing-systems",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "build:all": "turbo run build",
    "build:storybook": "turbo run build --filter=@wowsyler/ds-storybook",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter @wowsyler/ds-storybook dev",
    "audit:responsive": "pnpm --filter @wowsyler/ds-storybook audit:responsive",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "changeset": "changeset",
    "version-packages": "node scripts/version-packages.mjs",
    "release": "pnpm build && changeset publish",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
