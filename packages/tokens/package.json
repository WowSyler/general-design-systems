{
  "name": "@wowsyler/ds-tokens",
  "version": "0.2.0",
  "description": "Çok temalı tasarım tokenları: CSS custom property'leri, Tailwind v3 preset'i, Tailwind v4 köprüsü ve React Native tema objeleri.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WowSyler/general-design-systems.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/WowSyler/general-design-systems/tree/main/packages/tokens#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js",
      "default": "./dist/native/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js",
      "default": "./dist/tailwind-preset.js"
    },
    "./css/*": "./dist/css/*",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  }
}
