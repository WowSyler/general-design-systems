{
  "name": "@wowsyler/ds-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "audit:responsive": "node scripts/audit-responsive.mjs --dir storybook-static --out audit-report.json"
  },
  "dependencies": {
    "@wowsyler/ds-tokens": "workspace:*",
    "@wowsyler/ds-ui": "workspace:*",
    "@wowsyler/ds-ui-native": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.474.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.47",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "storybook": "^10.5.2",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
